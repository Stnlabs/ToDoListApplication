<Window x:Class="ToDoListApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDoListApplication"
        mc:Ignorable="d"
        Title="Todolist" Height="450" Width="800">
    <Border BorderBrush="Black" BorderThickness="2" CornerRadius="5" Padding="10" Margin="44,10,528,12">
        <Grid >

            <!-- Ein weiteres erlaubtes Element im selben Dokument -->
            <Button Content="Save" HorizontalAlignment="Left" x:Name="SaveBTN" Margin="37,338,0,0" VerticalAlignment="Top" Height="25" Width="122" Click="SaveBTN_Click_1"/>
            <Label Content="Counter:" Margin="0,10,86,339" RenderTransformOrigin="0.242,0.584"/>
            <TextBox Text="" FontSize="12" x:Name="Counter" TextChanged="Counter_TextChanged" TextAlignment="Center" Margin="132,10,10,342"/>
            <TextBox Text="" FontSize="12" x:Name="Timer" TextAlignment="Center" Margin="132,54,10,300"/>
            <Label Content="Timer:" Margin="0,54,125,300"/>
            <StackPanel>

                <StackPanel Margin="0, 150, 0, 0" x:Name="DynamicControlsPanel"/>

            </StackPanel>


        </Grid>
    </Border>
</Window>


