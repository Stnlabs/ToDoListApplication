<Window x:Class="ToDoListApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDoListApplication"
        mc:Ignorable="d"
        Title="Todolist"
        Height="450"
        Width="800">

    <Border BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="5"
            Padding="10"
            Margin="44,10,528,12">

        <Grid>

            <!-- Counter -->
            <Label Content="Counter:"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="0,10,0,0"/>

            <TextBox x:Name="Counter"
                     FontSize="12"
                     TextAlignment="Center"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Width="100"
                     Height="25"
                     Margin="132,10,0,0"
                     TextChanged="Counter_TextChanged"/>


            <!-- Timer -->
            <Label Content="Timer:"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="0,54,0,0"/>

            <TextBox x:Name="Timer"
                     FontSize="12"
                     TextAlignment="Center"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Width="100"
                     Height="25"
                     Margin="132,54,0,0"/>


            <!-- Dynamisch erzeugte Aktivitäten -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,100,0,50">

                <StackPanel x:Name="DynamicControlsPanel"/>

            </ScrollViewer>


            <!-- Save Button -->
            <Button x:Name="SaveBTN"
                    Content="Save"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Width="122"
                    Height="25"
                    Click="SaveBTN_Click_1"/>

        </Grid>

    </Border>

</Window>

